{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zukunft",
  "version": "0.1.13",
  "identifier": "dev.zukunft.app",
  "build": {
    "frontendDist": "../next/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "yarn workspace @zukunft/desktop dev",
    "beforeBuildCommand": "yarn workspace @zukunft/desktop build"
  },
  "app": {
    "windows": [
      {
        "title": "Zukunft",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "fullscreen": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https://avatars.githubusercontent.com data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}

{
  "name": "zukunft",
  "version": "0.1.6",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "apps/desktop/next",
    "apps/web/next",
    "packages/*"
  ],
  "scripts": {
    "dev:desktop": "yarn workspace @zukunft/desktop dev",
    "dev:web": "yarn workspace @zukunft/web dev",
    "tauri:dev": "yarn workspace @zukunft/desktop-app dev",
    "tauri:build": "yarn workspace @zukunft/desktop-app build",
    "build": "yarn build:desktop && yarn build:web",
    "build:desktop": "yarn workspace @zukunft/desktop build",
    "build:web": "yarn workspace @zukunft/web build",
    "typecheck": "tsc --noEmit -p packages/domain && tsc --noEmit -p packages/gantt && tsc --noEmit -p packages/github && tsc --noEmit -p apps/desktop/next && tsc --noEmit -p apps/web/next",
    "test": "yarn workspace @zukunft/domain test",
    "verify": "yarn typecheck && yarn test"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
